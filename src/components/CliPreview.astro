---
import { Code } from "astro:components";
import { cliSafe, cliGated } from "../data/homepage.ts";
---

<div class="cli">
  <div class="term">
    <div class="term-bar">
      <span class="term-label">hostwright · read-only</span>
    </div>
    <Code code={cliSafe} lang="bash" theme="github-light" />
  </div>

  <div class="term">
    <div class="term-bar">
      <span class="term-label">hostwright · confirmed mutation</span>
    </div>
    <Code code={cliGated} lang="bash" theme="github-light" />
  </div>
</div>

<p class="cli-caption">
  The read-only commands observe and plan without changing the runtime.
  Mutation happens only through the two confirmed gates, one action at a time.
</p>

<style>
  .cli {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  .term {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-card);
  }
  .term-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .term-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  /* Code component renders its own <pre>; strip the doubled border/radius. */
  .term :global(pre.astro-code) {
    border: 0 !important;
    border-radius: 0 !important;
    margin: 0;
  }
  .cli-caption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: var(--width-prose);
  }

  @media (min-width: 46rem) {
    .cli {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>
